# Add local credentials here only; never commit real secrets.
FINN_LLM_API_KEY=
DATABASE_URL=
# OpenRouter (OpenAI-compatible API); Auto selects a model per request.
FINN_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
FINN_OPENROUTER_MODEL=openrouter/auto
FINN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINN_SITE_URL=http://localhost:5173
FINN_SITE_NAME=FINN Investor Intelligence
# Optional direct OpenAI provider; OpenRouter takes precedence when both keys exist.
OPENAI_API_KEY=
FINN_OPENAI_MODEL=gpt-6-astra
# Optional local model; no API key required. Install Ollama and pull the model first.
# FINN_LLM_PROVIDER=ollama
# FINN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# FINN_OLLAMA_MODEL=your-installed-model-tag
